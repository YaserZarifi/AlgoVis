{
  "name": "@tracecam/theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Palettes, type pairings, and timing constants. Every tunable number lives here.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "fonts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tracecam/schema": "workspace:*"
  }
}
